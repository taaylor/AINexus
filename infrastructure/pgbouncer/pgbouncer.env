# Общие настройки PgBouncer. Этот образ преобразует переменные PGBOUNCER_*
# в параметры секции [pgbouncer] файла pgbouncer.ini.
#
# Режим по умолчанию: серверное соединение PostgreSQL возвращается в пул
# после завершения каждой транзакции.
PGBOUNCER_POOL_MODE=transaction

# Dev only: пароль клиента не проверяется. DATABASES_USER принудительно
# задаёт пользователя для подключения к PostgreSQL. Порт PgBouncer не
# опубликован на хост, но любой контейнер в общей Compose-сети может подключиться.
PGBOUNCER_AUTH_TYPE=any

# Максимум одновременных клиентских подключений к PgBouncer.
# Это не лимит соединений PgBouncer -> PostgreSQL.
PGBOUNCER_MAX_CLIENT_CONN=120

# Размер серверного пула по умолчанию для каждой пары пользователь/база.
# Для текущей базы отдельно задан DATABASES_POOL_SIZE.
PGBOUNCER_DEFAULT_POOL_SIZE=30

# Глобальное число дополнительных серверных соединений для очереди.
# Для текущей базы отдельно задан DATABASES_RESERVE_POOL.
PGBOUNCER_RESERVE_POOL_SIZE=5

# Размер LRU-кэша именованных prepared statements на серверное соединение.
# Ненулевое значение включает поддержку prepared statements в transaction pooling.
PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# Как часто обновлять агрегированную статистику SHOW STATS, в секундах.
PGBOUNCER_STATS_PERIOD=10

# Настройки пула конкретной базы. Перекрывают одноимённые глобальные настройки.
# DATABASES_* задаёт единственную запись [databases] в этом Compose-сервисе.
# DATABASES_HOST/PORT/USER/PASSWORD/DBNAME задаются в docker-compose.dev.yml.

# Переопределяет глобальный режим пула для этой базы.
DATABASES_POOL_MODE=transaction

# Максимум backend-соединений PostgreSQL в пуле этой базы.
DATABASES_POOL_SIZE=20

# Дополнительные backend-соединения для этой базы при очереди ожидания.
# Используется после reserve_pool_timeout (по умолчанию PgBouncer — 5 секунд).
DATABASES_RESERVE_POOL=5

# Жёсткий суммарный предел backend-соединений PgBouncer к этой базе.
# В dev у PostgreSQL max_connections=100; этот лимит оставляет запас
# для прямых подключений и администрирования.
DATABASES_MAX_DB_CONNECTIONS=40

# Переменная Docker-образа: не выводить сгенерированную конфигурацию при старте.
QUIET=1
